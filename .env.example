# Copy to .env (never commit it) or export these in your shell. llm-bench reads keys only from the
# environment variable each endpoint names in its configuration (api_key_env).
MOLOCHAI_API_KEY=your-api-key
# Optional: point the molochai preset at another base URL, e.g. the mock server.
# MOLOCHAI_BASE_URL=http://127.0.0.1:4010/api/v1
# For benchmarks/openai-compatible.yaml:
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=a-model-id
